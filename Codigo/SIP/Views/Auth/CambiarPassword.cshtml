@model CambiarPasswordVm

@{
    ViewData["Title"] = "Cambiar contraseña";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 mx-auto" style="max-width:520px;">
        <div class="card-header sip-card-header">
            <i class="bi bi-key"></i> Cambiar contraseña
        </div>

        <div class="card-body">
            <form asp-controller="Auth" asp-action="CambiarPassword" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label">Contraseña actual</label>
                    <input asp-for="PasswordActual" type="password" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Nueva contraseña</label>
                    <input asp-for="PasswordNueva" type="password" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Confirmar nueva contraseña</label>
                    <input asp-for="ConfirmarPassword" type="password" class="form-control" required />
                </div>

                <button type="submit" class="btn btn-sip w-100">
                    <i class="bi bi-save2"></i> Actualizar contraseña
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Ok"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Contraseña actualizada',
                text: '@TempData["Ok"]',
                confirmButtonColor: '#7A4A2E'
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'No se pudo actualizar',
                text: '@TempData["Error"]',
                confirmButtonColor: '#7A4A2E'
            });
        </script>
    }
}

