@model LoginUsr
@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewData["Title"] = "Iniciar sesión";
}

<div class="sip-login-card">

    <div class="text-center mb-3">
        <div class="sip-brand mb-2">
            <img src="~/img/logo.png" alt="SIP" />
        </div>
        <h4 class="sip-brand-title">SIP</h4>
        <p class="sip-subtitle">Sistema Integral en Psicoterapia</p>
    </div>

    <form asp-controller="Auth" asp-action="Login" method="post" class="mt-3">
        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="ReturnUrl" />

        <div class="mb-3">
            <label class="form-label">Usuario</label>
            <input asp-for="UserName" class="form-control" autocomplete="username" required />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>

        <div class="mb-2">
            <label class="form-label">Contraseña</label>
            <div class="input-group">
                <input asp-for="Password" class="form-control" type="password" autocomplete="current-password" required />
                <button class="btn btn-outline-secondary" type="button" id="btnTogglePass">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-2 mb-3">
            @* <div class="form-check">
                <input class="form-check-input" asp-for="RememberMe" />
                <label class="form-check-label" asp-for="RememberMe">Recordarme</label>
            </div> *@

            @* <a asp-controller="Auth" asp-action="ForgotPassword" class="small text-decoration-none" href="#" style="color:#7A4A2E;">¿Olvidaste tu contraseña?</a> *@
            <a asp-controller="Auth"
               asp-action="ForgotPassword"
               class="small text-decoration-none"
               style="color:#7A4A2E;">
                ¿Olvidaste tu contraseña?
            </a>
        </div>

        <button type="submit" class="btn btn-sip w-100">
            <i class="bi bi-box-arrow-in-right"></i> Entrar
        </button>

        <div class="text-center mt-3">
            <small class="text-muted">© @DateTime.Now.Year SIP</small>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Mostrar/ocultar password
        document.getElementById('btnTogglePass')?.addEventListener('click', () => {
            const input = document.querySelector('input[name="Password"]');
            if (!input) return;
            input.type = (input.type === 'password') ? 'text' : 'password';
        });

        // Validación rápida antes de enviar
        $('form').on('submit', function (e) {
            const user = $('[name="UserName"]').val().trim();
            const pass = $('#password').val().trim();

            if (!user || !pass) {
                e.preventDefault();
                Swal.fire('', 'Por favor, ingresa usuario y contraseña.', 'warning');
                return;
            }
        });

        // Mensajes desde el servidor (usando TempData)
        @if (TempData["Error"] is string err && !string.IsNullOrWhiteSpace(err))
        {
                    <text>
                    Swal.fire('', '@err', 'error');
                    </text>
        }
        @if (TempData["Ok"] is string ok && !string.IsNullOrWhiteSpace(ok))
        {
                    <text>
                    Swal.fire('', '@ok', 'success');
                    </text>
        }
    </script>
}


