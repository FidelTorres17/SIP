@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewData["Title"] = "Recuperar contraseña";
}

<div class="sip-login-card">
    <div class="text-center mb-3">
        <img src="~/img/logo-sip.png" style="height:70px;" />
        <h4 class="sip-brand-title mt-2">Recuperar contraseña</h4>
        <p class="sip-subtitle">Ingresa el correo registrado en SIP</p>
    </div>

    <form asp-controller="Auth" asp-action="ForgotPassword" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label class="form-label">Correo electrónico</label>
            <input type="email"
                   name="email"
                   class="form-control"
                   required
                   placeholder="correo@ejemplo.com" />
        </div>

        <button type="submit" class="btn btn-sip w-100">
            <i class="bi bi-envelope-check"></i> Enviar recuperación
        </button>

        <div class="text-center mt-3">
            <a asp-controller="Auth"
               asp-action="Login"
               style="color:#7A4A2E;">
                Volver al inicio de sesión
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @if (TempData["Ok"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Correo enviado',
                text: '@TempData["Ok"]',
                confirmButtonColor: '#7A4A2E'
            });
        </script>
    }

    @if (TempData["Error"] != null)
    {
        <script>
            Swal.fire({
                icon: 'error',
                title: 'No se pudo enviar',
                text: '@TempData["Error"]',
                confirmButtonColor: '#7A4A2E'
            });
        </script>
    }
}

