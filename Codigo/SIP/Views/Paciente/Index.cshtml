@model IEnumerable<SIP.Models.Paciente>

@{
    ViewData["Title"] = "Pacientes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0 text-sip">Pacientes</h2>
        <small class="text-muted">Administración de pacientes</small>
    </div>

    <button type="button" class="btn btn-sip" data-bs-toggle="modal" data-bs-target="#modalPaciente"
            id="btnNuevoPaciente">
        <i class="bi bi-person-plus"></i> Nuevo paciente
    </button>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body">
        <div class="table-responsive">
            <table id="tblPacientes" class="table table-hover align-middle w-100">
                <thead class="table-light">
                    <tr>
                        <th style="width:60px;">#</th>
                        <th>Nombre</th>
                        <th>Fecha de N.</th>
                        <th>Sexo</th>
                        <th>Teléfono</th>
                        <th>Email</th>
                        @* <th>Activo</th> *@
                        <th class="text-center" style="width:180px;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var i = 1;
                        foreach (var u in Model)
                        {
                            var nombreCompleto = $"{u.Nombre} {u.ApellidoP} {u.ApellidoM}".Trim();
                            <tr>
                                <td>@i</td>
                                <td class="fw-semibold">@nombreCompleto</td>
                                <td>@u.FechaNacimiento</td>
                                <td>@u.Sexo</td>
                                <td>@u.Telefono</td>
                                <td>@u.Email</td>

                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-outline-sip btn-sm btnEditar"
                                            data-id="@u.PacienteId"
                                            data-nombre="@u.Nombre"
                                            data-apellidop="@u.ApellidoP"
                                            data-apellidom="@u.ApellidoM"
                                        data-fechanacimiento="@(u.FechaNacimiento?.ToString("yyyy-MM-dd") ?? "")"
                                            data-email="@u.Email"
                                            data-telefono="@u.Telefono"
                                            data-sexo="@u.Sexo">
                                        <i class="bi bi-pencil-square"></i> Editar
                                    </button>

                                    @*<button type="button"
                                            class="btn btn-outline-danger btn-sm btnEliminar"
                                            data-id="@u.PacienteId"
                                            data-nombre="@nombreCompleto">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>*@

                                    <button type="button"
                                            class="btn btn-outline-sip btn-sm btnAgendarCita"
                                            data-id="@u.PacienteId"
                                            data-nombre="@($"{u.Nombre} {u.ApellidoP} {u.ApellidoM}")">
                                        <i class="bi bi-calendar-plus"></i> Agendar cita
                                    </button>

                                    <a asp-controller="Expedientes"
                                       asp-action="AbrirExpediente"
                                       asp-route-pacienteId="@u.PacienteId"
                                       class="btn btn-outline-sip btn-sm">

                                        <i class="bi bi-folder2-open"></i> Expediente

                                    </a>

                                </td>
                            </tr>

                            i++;
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ===================== MODAL PACIENTE ===================== -->
<div class="modal fade" id="modalPaciente" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0">

            <!-- HEADER -->
            <div class="modal-header sip-modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-person-hearts"></i> Paciente
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <form id="formPaciente">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="PacienteId" name="PacienteId" />

                    <div class="row g-3">

                        <!-- NOMBRE -->
                        <div class="col-md-4">
                            <label class="form-label">Nombre</label>
                            <input class="form-control" id="Nombre" name="Nombre" required />
                        </div>

                        <!-- APELLIDO P -->
                        <div class="col-md-4">
                            <label class="form-label">Apellido Paterno</label>
                            <input class="form-control" id="ApellidoP" name="ApellidoP" required />
                        </div>

                        <!-- APELLIDO M -->
                        <div class="col-md-4">
                            <label class="form-label">Apellido Materno</label>
                            <input class="form-control" id="ApellidoM" name="ApellidoM" />
                        </div>

                        <!-- FECHA NACIMIENTO -->
                        <div class="col-md-4">
                            <label class="form-label">Fecha de nacimiento</label>
                            <input type="date" class="form-control" id="FechaNacimiento" name="FechaNacimiento" />
                        </div>

                        <!-- SEXO -->
                        <div class="col-md-4">
                            <label class="form-label">Sexo</label>
                            <select class="form-select" id="Sexo" name="Sexo" required>
                                <option value="">Selecciona</option>
                                <option value="Femenino">Femenino</option>
                                <option value="Masculino">Masculino</option>
                                <option value="Otro">Otro</option>
                            </select>
                        </div>

                        <!-- TELEFONO -->
                        <div class="col-md-4">
                            <label class="form-label">Teléfono</label>
                            <input class="form-control" id="Telefono" name="Telefono" maxlength="10" />
                        </div>

                        <!-- EMAIL -->
                        <div class="col-md-6">
                            <label class="form-label">Correo electrónico</label>
                            <input type="email" class="form-control" id="Email" name="Email" />
                        </div>

                    </div>
                </form>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button" class="btn btn-sip" id="btnGuardarPaciente">
                    <i class="bi bi-save2"></i> Guardar
                </button>
            </div>

        </div>
    </div>
</div>

<!-- ===================== MODAL CITAS ===================== -->
<div class="modal fade" id="modalCita" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header sip-modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-calendar2-plus"></i> Agendar cita
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <form id="formCita">
                    @Html.AntiForgeryToken()

                    <input type="hidden" id="CitaPacienteId" name="PacienteId" />
                    <input type="hidden" id="EsAdmin" value="@ViewBag.EsAdmin.ToString().ToLower()" />

                    @if (!(bool)ViewBag.EsAdmin)
                    {
                        <input type="hidden" id="CitaUsuarioId" name="UsuarioId" value="@ViewBag.UsuarioIdLogueado" />
                    }

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">Fecha</label>
                            <input type="date" class="form-control" id="Fecha" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Hora</label>
                            <input type="time" class="form-control" id="Hora" required />
                        </div>

                        <div class="col-md-6">
                            <div class="text-muted small">Paciente</div>
                            <div class="fw-semibold" id="lblPaciente"></div>
                        </div>

                        @if ((bool)ViewBag.EsAdmin)
                        {
                            <div class="col-md-6">
                                <label class="form-label">Terapeuta</label>
                                <select class="form-select" id="CitaUsuarioId" name="UsuarioId">
                                    <option value="">Selecciona</option>
                                    @foreach (var t in ViewBag.Terapeutas)
                                    {
                                        <option value="@t.UsuarioId">
                                            @t.Nombre @t.ApellidoP @t.ApellidoM
                                        </option>
                                    }
                                </select>
                            </div>
                        }
                        else
                        {
                            <div class="col-md-6">
                                <div class="text-muted small">Terapeuta</div>
                                <div class="fw-semibold">Usuario logueado</div>
                            </div>
                        }

                        <div class="col-md-6">
                            <label class="form-label">Estatus</label>
                            <select class="form-select" id="EstatusCitaId" name="EstatusCitaId">
                                <option value="">Selecciona</option>
                                <option value="1">Pendiente</option>
                                <option value="2">Confirmada</option>
                                <option value="3">Cancelada</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label">Notas</label>
                            <input class="form-control" id="Notas" name="Notas" maxlength="250" />
                        </div>
                    </div>
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    Cancelar
                </button>

                <button type="button" class="btn btn-sip" id="btnGuardarCita">
                    <i class="bi bi-save2"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <!-- DataTables (usa tu versión actual o reemplaza por la que tengas) -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Si ya tienes los js de datatable en tu layout, puedes quitar estas 2 líneas -->
    <script src="https://cdn.datatables.net/1.10.13/js/jquery.dataTables.min.js"></script>
    <link rel="stylesheet" href="https://cdn.datatables.net/1.10.13/css/jquery.dataTables.min.css" />
    <script src="~/js/Paciente.js"></script>
    
                @if (TempData["Error"] != null)
        {
                <script>
                    Swal.fire({
                        icon: 'warning',
                        title: 'Expediente no disponible',
                        text: '@TempData["Error"]',
                        confirmButtonColor: '#7A4A2E'
                    });
                 </script>
    }
    
@*     @if (TempData["Ok"] != null)
    {
        <script>
            Swal.fire({
                icon: 'success',
                title: 'Correcto',
                text: '@TempData["Ok"]',
                confirmButtonColor: '#7A4A2E'
            });
        </script>
    } *@

    <script>
        $(function () {
            // DataTable
            $('#tblPacientes').DataTable({
                pageLength: 10,
                order: [[0, 'asc']],
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_",
                    info: "Mostrando _START_ a _END_ de _TOTAL_",
                    paginate: { previous: "Anterior", next: "Siguiente" },
                    zeroRecords: "No se encontraron usuarios"
                }
            });






        });

              $(document).on('click', '.btnAgendarCita', function () {
            const pacienteId = $(this).data('id');
            const pacienteNombre = $(this).data('nombre');

            $('#CitaPacienteId').val(pacienteId);
            $('#lblPaciente').text(pacienteNombre);

            $('#Fecha').val('');
            $('#Hora').val('');
            $('#EstatusCitaId').val('');
            $('#Notas').val('');

            if ($('#EsAdmin').val() === 'true') {
                $('#CitaUsuarioId').val('');
            }

            new bootstrap.Modal(document.getElementById('modalCita')).show();
        });

        $('#btnGuardarCita').on('click', function () {
            const fecha = $('#Fecha').val();
            const hora = $('#Hora').val();

            if (!$('#CitaPacienteId').val()) {
                Swal.fire('Aviso', 'No se encontró el paciente.', 'warning');
                return;
            }

            if (!$('#CitaUsuarioId').val()) {
                Swal.fire('Aviso', 'Selecciona o valida el terapeuta.', 'warning');
                return;
            }

            if (!fecha || !hora) {
                Swal.fire('Aviso', 'Selecciona fecha y hora.', 'warning');
                return;
            }

            if (!$('#EstatusCitaId').val()) {
                Swal.fire('Aviso', 'Selecciona el estatus de la cita.', 'warning');
                return;
            }

            const data = {
                __RequestVerificationToken: $('#formCita input[name="__RequestVerificationToken"]').val(),
                PacienteId: $('#CitaPacienteId').val(),
                UsuarioId: $('#CitaUsuarioId').val(),
                EstatusCitaId: $('#EstatusCitaId').val(),
                FechaHora: `${fecha}T${hora}:00`,
                Notas: $('#Notas').val()
            };

            $.ajax({
                url: '/Citas/GuardarDesdePaciente',
                type: 'POST',
                data: data,
                success: function (res) {
                    if (res.ok) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Cita registrada',
                            text: res.mensaje,
                            confirmButtonColor: '#7A4A2E'
                        }).then(() => {
                            bootstrap.Modal.getInstance(document.getElementById('modalCita')).hide();
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', res.mensaje, 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Ocurrió un error al guardar la cita.', 'error');
                }
            });
        });
                 </script>
}

